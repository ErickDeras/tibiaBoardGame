generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id             String          @id @default(cuid())
  name           String
  width          Int             @default(12)
  height         Int             @default(12)
  objects        GameObject[]
  equipmentItems EquipmentItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model GameObject {
  id            String      @id @default(cuid())
  boardId       String
  board         Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x             Int
  y             Int
  name          String
  profession    Profession
  helmet        String      @default("")
  armor         String      @default("")
  legs          String      @default("")
  boots         String      @default("")
  weapon        String      @default("")
  shield        String      @default("")
  ring          String      @default("")
  necklace      String      @default("")
  backpack      String      @default("")
  hitpoints     Int
  manaPoints    Int
  staminaPoints Int
  valueAttack   Int         @default(0)
  valueDefense  Int         @default(0)
  swordSkill    Int         @default(0)
  axeSkill      Int         @default(0)
  maceSkill     Int         @default(0)
  distanceSkill Int         @default(0)
  shieldingSkill Int        @default(0)
  magicLevel    Int         @default(0)
  experiencePoints Int      @default(0)
  capacityPoints Int        @default(0)
  spriteUrl     String      @default("")
  cards         Card[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([boardId, x, y])
}

model Card {
  id           String     @id @default(cuid())
  gameObjectId String
  gameObject   GameObject @relation(fields: [gameObjectId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
}

model EquipmentItem {
  id             String        @id @default(cuid())
  boardId        String
  board          Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  slot           EquipmentSlot
  name           String
  valueAttack    Int           @default(0)
  valueDefense   Int           @default(0)
  swordSkill     Int           @default(0)
  axeSkill       Int           @default(0)
  maceSkill      Int           @default(0)
  distanceSkill  Int           @default(0)
  shieldingSkill Int           @default(0)
  magicLevel     Int           @default(0)
  weight         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([boardId, slot, name])
}

enum Profession {
  mago
  guerrero
  paladin
  druida
}

enum EquipmentSlot {
  Helmet
  Armor
  Legs
  Boots
  Weapon
  Shield_Quiver
  Necklace
  Ring
  Backpack
}
