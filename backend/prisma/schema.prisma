generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Dungeon {
  id          String         @id @default(cuid())
  name        String
  notes       String         @default("")
  targetLevel Int?
  floors      DungeonBoard[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model DungeonBoard {
  id        String   @id @default(cuid())
  dungeonId String
  dungeon   Dungeon  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  boardId   String   @unique
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  floor     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dungeonId, floor])
}

model Board {
  id             String          @id @default(cuid())
  name           String
  width          Int             @default(12)
  height         Int             @default(12)
  objects        GameObject[]
  equipmentItems EquipmentItem[]
  dungeonLink    DungeonBoard?
  combatSession  CombatSession?
  groundLoots    GroundLoot[]
  matchArchives  MatchArchive[]
  roomChatMessages   RoomChatMessage[]
  lobbyDevMessages LobbyDevChatMessage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/** Sesión en la sala global (máx. 4 activas por ventana de actividad). */
model LiveSession {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  username         String
  /** false hasta que el usuario elija nombre (bootstrap + PATCH). */
  displayNameSet   Boolean       @default(false)
  lastSeenAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())
  ownedPlayer      GameObject?
  roomChatMessages   RoomChatMessage[]
  lobbyDevMessages   LobbyDevChatMessage[]
}

/** Chat de sala archivado con cada partida (lobby previo + combate). */
model RoomChatMessage {
  id            String      @id @default(cuid())
  boardId       String
  board         Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  username      String
  characterName String?
  body          String
  createdAt     DateTime    @default(now())

  @@index([boardId, createdAt])
}

/** Chat solo entre partidas (sin combate activo); se muestra en Notas dev. */
model LobbyDevChatMessage {
  id            String      @id @default(cuid())
  boardId       String
  board         Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  liveSessionId String
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  username      String
  body          String
  createdAt     DateTime    @default(now())

  @@index([boardId, createdAt])
}

/** Copia del log de combate al terminar la partida (historial). */
model MatchArchive {
  id              String   @id @default(cuid())
  boardId         String
  board           Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  endedAt         DateTime
  entries         Json
  conversationLog Json     @default("[]")
  createdAt       DateTime @default(now())

  @@index([boardId, endedAt])
}

model DevNote {
  id               String   @id @default(cuid())
  body             String
  authorUsername   String?
  createdAt        DateTime @default(now())
}

model CombatSession {
  id             String               @id @default(cuid())
  boardId        String               @unique
  board          Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status         CombatSessionStatus  @default(ACTIVE)
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  turnOrder      Json                 @default("[]")
  turnIndex      Int                  @default(0)
  generation     Int                  @default(0)
  pendingAddIds  Json                 @default("[]")
  currentActorId String?
  actorTurnState Json?
  /** Criaturas vivas al iniciar la partida (para fin de combate cuando ya no quedan instancias en BD). */
  initialAliveCreatureCount Int        @default(0)
  logEntries     CombatLogEntry[]

  @@index([boardId])
}

model CombatLogEntry {
  id        String          @id @default(cuid())
  sessionId String
  session   CombatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  type      String
  payload   Json

  @@index([sessionId, createdAt])
}

model ItemTemplate {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  weight      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lootEntries LootEntry[]
  groundLoots GroundLoot[]
}

model GroundLoot {
  id               String        @id @default(cuid())
  boardId          String
  board            Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x                Int
  y                Int
  itemName         String
  weight           Int           @default(0)
  quantity         Int           @default(1)
  itemTemplateId   String?
  itemTemplate     ItemTemplate? @relation(fields: [itemTemplateId], references: [id], onDelete: SetNull)

  @@index([boardId, x, y])
}

model GameObject {
  id                 String           @id @default(cuid())
  boardId            String
  board              Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x                  Int
  y                  Int
  name               String
  objectKind         ObjectKind       @default(PLAYER)
  profession         Profession?
  creatureTemplateId String?
  creatureTemplate   CreatureTemplate? @relation(fields: [creatureTemplateId], references: [id], onDelete: SetNull)
  helmet             String           @default("")
  armor              String           @default("")
  legs               String           @default("")
  boots              String           @default("")
  weapon             String           @default("")
  shield             String           @default("")
  ring               String           @default("")
  necklace           String           @default("")
  backpackEquipment  String           @default("")
  hitpoints          Int
  manaPoints         Int
  staminaPoints      Int
  attackValue        Int              @default(0)
  defenseValue       Int              @default(0)
  magicAttackValue   Int              @default(0)
  swordSkill         Int              @default(0)
  axeSkill           Int              @default(0)
  maceSkill          Int              @default(0)
  distanceSkill      Int              @default(0)
  shieldingSkill     Int              @default(0)
  magicLevel         Int              @default(0)
  experiencePoints   Int              @default(0)
  experienceLevel    Int              @default(1)
  gold               Int              @default(0)
  manaRegen          Int              @default(0)
  staminaRegen       Int              @default(0)
  capacityMax        Int              @default(0)
  spriteUrl          String           @default("")
  cards              Card[]
  inventorySlots     InventorySlot[]
  ownerSessionId     String?          @unique
  ownerSession       LiveSession?     @relation(fields: [ownerSessionId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([boardId, x, y])
}

model InventorySlot {
  id           String     @id @default(cuid())
  gameObjectId String
  gameObject   GameObject @relation(fields: [gameObjectId], references: [id], onDelete: Cascade)
  slotIndex    Int
  itemName     String
  weight       Int        @default(0)
  quantity     Int        @default(1)

  @@unique([gameObjectId, slotIndex])
}

model Card {
  id           String       @id @default(cuid())
  gameObjectId String
  gameObject   GameObject   @relation(fields: [gameObjectId], references: [id], onDelete: Cascade)
  name         String
  description  String       @default("")
  deckCategory DeckCategory @default(SPELL_ATTACK)
  manaCost         Int?
  staminaCost      Int?
  capacityCost     Int?
  rapidSpell       Boolean  @default(false)
  spellSkillBonus  Int      @default(0)
  critMultiplier   Int?
  damageSkill      SpellDamageSkill?
}

model CardTemplate {
  id               String          @id @default(cuid())
  name             String
  description      String          @default("")
  deckCategory     DeckCategory    @default(SPELL_ATTACK)
  manaCost         Int?
  staminaCost      Int?
  capacityCost     Int?
  rapidSpell       Boolean         @default(false)
  spellSkillBonus  Int             @default(0)
  critMultiplier   Int?
  damageSkill      SpellDamageSkill?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CreatureTemplate {
  id             String      @id @default(cuid())
  name           String
  spriteUrl      String      @default("")
  hitpoints      Int         @default(10)
  manaPoints     Int         @default(0)
  staminaPoints  Int         @default(0)
  attackValue    Int         @default(0)
  defenseValue   Int         @default(0)
  swordSkill     Int         @default(0)
  axeSkill       Int         @default(0)
  maceSkill      Int         @default(0)
  distanceSkill  Int         @default(0)
  shieldingSkill Int         @default(0)
  magicLevel         Int         @default(0)
  abilityName        String      @default("")
  abilityManaCost    Int         @default(0)
  abilityAttackBonus Int         @default(0)
  experiencePoints   Int         @default(0)
  lootEntries        LootEntry[]
  instances          GameObject[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model LootEntry {
  id                 String           @id @default(cuid())
  creatureTemplateId String
  creatureTemplate   CreatureTemplate @relation(fields: [creatureTemplateId], references: [id], onDelete: Cascade)
  itemName           String
  weight             Int              @default(0)
  quantity           Int              @default(1)
  itemTemplateId     String?
  itemTemplate       ItemTemplate?    @relation(fields: [itemTemplateId], references: [id], onDelete: SetNull)
}

model EquipmentItem {
  id             String        @id @default(cuid())
  boardId        String
  board          Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  slot           EquipmentSlot
  name           String
  valueAttack    Int           @default(0)
  valueDefense   Int           @default(0)
  swordSkill     Int           @default(0)
  axeSkill       Int           @default(0)
  maceSkill      Int           @default(0)
  distanceSkill  Int           @default(0)
  shieldingSkill Int           @default(0)
  magicLevel     Int           @default(0)
  weight         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([boardId, slot, name])
}

enum Profession {
  mago
  guerrero
  paladin
  druida
}

enum ObjectKind {
  PLAYER
  CREATURE
}

enum DeckCategory {
  SPELL_ATTACK
  SPELL_SUPPORT
  SPELL_DEFENSIVE
  SPELL_HEALING
  RUNE_ATTACK
  RUNE_SUPPORT
  RUNE_DEFENSIVE
  RUNE_HEALING
  ITEM_ATTACK
  ITEM_SUPPORT
  ITEM_DEFENSIVE
  ITEM_HEALING
}

enum SpellDamageSkill {
  SWORD
  AXE
  MACE
  SHIELD
  DISTANCE
}

enum EquipmentSlot {
  Helmet
  Armor
  Legs
  Boots
  Weapon
  Shield_Quiver
  Necklace
  Ring
  Backpack
}

enum CombatSessionStatus {
  ACTIVE
  ENDED
}
